<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoSetup_Win - Tạo USB cài Windows" Width="980" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#F3F3F3">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
        <SolidColorBrush x:Key="Muted" Color="#5F6368"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0C5AA0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B3261E"/>
            <Setter Property="BorderBrush" Value="#E5A39E"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADADA"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,16,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3,16,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="txtQuyen" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            <StackPanel>
                <TextBlock Text="Tạo USB cài Windows tự động" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                           Text="USB Ventoy: chứa nhiều ISO (Windows, cứu hộ...); ISO Windows có thêm menu AutoSetup để cài tự động và cài ứng dụng sau khi cài."/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="tabs" Grid.Row="1" Padding="12" Background="White">
            <TabItem x:Name="tabUsb" Header="  1. USB  ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Cắm USB rồi bấm Làm mới. Danh sách chỉ có ổ USB và thẻ nhớ: ổ cứng trong máy không bao giờ hiện ở đây. USB mới thì cài Ventoy (xoá sạch USB); USB đã có Ventoy thì dùng luôn, dữ liệu trên đó giữ nguyên."/>
                    <StackPanel DockPanel.Dock="Bottom">
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox x:Name="cbSecureBoot" Content="Hỗ trợ Secure Boot" IsChecked="True"/>
                            <CheckBox x:Name="cbGpt" Content="Kiểu phân vùng GPT (bỏ trống: MBR, khởi động được cả máy cũ lẫn UEFI)"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="btnLamMoiUsb" Content="Làm mới"/>
                            <Button x:Name="btnCaiVentoy" Style="{StaticResource Danger}" Content="Cài Ventoy (XOÁ SẠCH USB)"/>
                            <Button x:Name="btnCapNhatVentoy" Content="Cập nhật Ventoy (giữ dữ liệu)"/>
                            <Button x:Name="btnChonThuMuc" Content="Dùng ổ hoặc thư mục khác..."/>
                        </WrapPanel>
                        <TextBlock x:Name="txtDich" FontWeight="SemiBold" Text="USB đích: chưa chọn"/>
                    </StackPanel>
                    <ListView x:Name="lvUsb" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Số" Width="44" DisplayMemberBinding="{Binding So}"/>
                                <GridViewColumn Header="Tên" Width="300" DisplayMemberBinding="{Binding Ten}"/>
                                <GridViewColumn Header="Dung lượng" Width="100" DisplayMemberBinding="{Binding KichThuocChu}"/>
                                <GridViewColumn Header="Ventoy" Width="80" DisplayMemberBinding="{Binding VentoyChu}"/>
                                <GridViewColumn Header="Ổ dữ liệu" Width="80" DisplayMemberBinding="{Binding ODuLieu}"/>
                                <GridViewColumn Header="Còn trống" Width="100" DisplayMemberBinding="{Binding ConTrong}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="tabIso" Header="  2. ISO  ">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="ISO Windows 10/11 (tên có Win10, Win11...) được thêm menu cài tự động. ISO khác như bộ cứu hộ (Anhdv Boot, Hiren's BootCD PE...) Ventoy vẫn khởi động được, chọn trong menu Ventoy. Phần mềm này không kèm ISO nào: tự tải ISO từ trang chính thức rồi thêm vào đây."/>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button x:Name="btnThemIso" Style="{StaticResource Primary}" Content="Thêm ISO..."/>
                        <Button x:Name="btnLamMoiIso" Content="Làm mới"/>
                        <Button x:Name="btnMoUsb" Content="Mở USB"/>
                    </WrapPanel>
                    <ListView x:Name="lvIso">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="File" Width="420" DisplayMemberBinding="{Binding Ten}"/>
                                <GridViewColumn Header="Dung lượng" Width="100" DisplayMemberBinding="{Binding KichThuocChu}"/>
                                <GridViewColumn Header="Trên USB" Width="260" DisplayMemberBinding="{Binding LoaiChu}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="tabCauHinh" Header="  3. Cấu hình  ">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button x:Name="btnLuuCauHinh" Style="{StaticResource Primary}" Content="Lưu cấu hình"/>
                        <Button x:Name="btnMoCauHinh" Content="Mở thư mục cấu hình (sửa nâng cao)"/>
                        <TextBlock x:Name="txtCauHinh" VerticalAlignment="Center" Margin="4,0,0,8" Foreground="{StaticResource Muted}"/>
                    </WrapPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <GroupBox Header="Bản quyền Windows">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Key"/>
                                        <ComboBox x:Name="cboBanQuyen" Grid.Column="1" Margin="0,3"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Grid.Row="1" Text="Phiên bản"/>
                                        <ComboBox x:Name="cboPhienBan" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Tài khoản Windows">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Cách tạo"/>
                                        <ComboBox x:Name="cboTaiKhoan" Grid.Column="1" Margin="0,3"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Grid.Row="1" Text="Tên đăng nhập"/>
                                        <TextBox x:Name="txtTen" Grid.Row="1" Grid.Column="1" Margin="0,3" ToolTip="1-20 ký tự không dấu"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Grid.Row="2" Text="Tên hiển thị"/>
                                        <TextBox x:Name="txtTenHienThi" Grid.Row="2" Grid.Column="1" Margin="0,3" ToolTip="Có dấu được; trống thì bằng tên đăng nhập"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Grid.Row="3" Text="Mật khẩu"/>
                                        <PasswordBox x:Name="pwdMatKhau" Grid.Row="3" Grid.Column="1" Margin="0,3" ToolTip="Bỏ trống: tài khoản không mật khẩu. Không lưu vào file cấu hình."/>
                                        <CheckBox x:Name="cbTuDangNhap" Grid.Row="4" Grid.Column="1" Content="Tự đăng nhập trong lúc cài ứng dụng (xong thì tắt, xoá mật khẩu đã lưu)"/>
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Tên máy">
                                    <StackPanel>
                                        <RadioButton x:Name="rbTenNgauNhien" GroupName="tenMay" Content="Windows đặt tên ngẫu nhiên"/>
                                        <RadioButton x:Name="rbTenHoi" GroupName="tenMay" Content="Hỏi tên máy khi khởi động USB"/>
                                        <DockPanel>
                                            <RadioButton x:Name="rbTenCoDinh" GroupName="tenMay" Content="Tên cố định:"/>
                                            <TextBox x:Name="txtTenMay" Margin="0,3" ToolTip="1-15 ký tự chữ, số, dấu gạch ngang; chỉ hợp khi USB dùng cho một máy"/>
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Ổ đĩa và menu Ventoy">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ổ C khi chia C-D (GB)"/>
                                        <TextBox x:Name="txtDungLuongC" Grid.Column="1" Margin="0,3" Width="90" HorizontalAlignment="Left"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Grid.Row="1" Text="Hết giờ thì chọn"/>
                                        <ComboBox x:Name="cboMacDinh" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                                        <TextBlock Style="{StaticResource FieldLabel}" Grid.Row="2" Text="Chờ chọn (giây, 0 = chờ mãi)"/>
                                        <TextBox x:Name="txtChoGiay" Grid.Row="2" Grid.Column="1" Margin="0,3" Width="90" HorizontalAlignment="Left"/>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <GroupBox Header="Sau khi cài Windows">
                                    <StackPanel>
                                        <CheckBox x:Name="cbUngDung" Content="Cài ứng dụng (danh sách bên dưới, qua winget)"/>
                                        <CheckBox x:Name="cbOffice" Content="Cài Office: Word, Excel, PowerPoint"/>
                                        <CheckBox x:Name="cbDriver" Content="Nạp driver trong \AutoSetup\drivers của USB"/>
                                        <CheckBox x:Name="cbCapNhat" Content="Cập nhật Windows (Windows Update)"/>
                                        <CheckBox x:Name="cbODuLieu" Content="Đưa phân vùng dữ liệu về chữ D"/>
                                        <CheckBox x:Name="cbTuKhoiDongLai" Content="Tự khởi động lại khi cần"/>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Ứng dụng cài sau khi cài Windows">
                                    <ListBox x:Name="lbUngDung" Height="300" BorderThickness="0"/>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="tabTao" Header="  4. Tạo USB  ">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Chép AutoSetup (file unattend, bước sau cài, cấu hình) lên USB và thêm menu cài tự động cho các ISO Windows. Thêm ISO sau này thì bấm Tạo USB lại."/>
                    <Border Background="#F7F9FC" BorderBrush="#DADADA" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                        <TextBlock x:Name="txtTomTat" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                    <CheckBox x:Name="cbChayThu" Content="Chạy thử: chỉ liệt kê việc sẽ làm, không ghi gì lên USB" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button x:Name="btnTao" Style="{StaticResource Primary}" Content="TẠO USB" FontSize="15" Padding="28,8"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Dùng: khởi động máy cần cài bằng USB, chọn ISO Windows trong menu Ventoy, rồi chọn kiểu cài trong menu AutoSetup (bản XOÁ SẠCH chỉ chạy khi máy có đúng một ổ trong)."/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,10,0,6">
            <TextBlock x:Name="txtTrangThai" DockPanel.Dock="Left" Width="340" VerticalAlignment="Center" Text="Sẵn sàng." TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="pbTienDo" Height="16" Minimum="0" Maximum="100" Value="0"/>
        </DockPanel>
        <TextBox x:Name="txtNhatKy" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Background="#1E1E1E" Foreground="#DCDCDC" Padding="6"/>
    </Grid>
</Window>
