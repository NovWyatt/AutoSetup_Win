<!--
  Mẫu cấu hình Office Deployment Tool cho AutoSetup_Win. Chép vào \AutoSetup\office\cau-hinh.xml trên USB, cạnh setup.exe.
  - Không có khoá sản phẩm: Microsoft 365 kích hoạt bằng đăng nhập tài khoản có giấy phép.
    Office LTSC (bản mua đứt, volume) thì đổi Product ID và Channel, thêm PIDKEY="..." của bạn
    (file trên USB có khoá thì giữ USB cẩn thận; .gitignore của repo không cho commit thư mục office\).
  - Muốn cài không cần mạng: chạy "setup.exe /download cau-hinh.xml" một lần, ODT tải về thư mục Office\Data cạnh setup.exe.
  - Tạo cấu hình khác tại https://config.office.com
-->
<Configuration>
  <Add OfficeClientEdition="64" Channel="Current">
    <Product ID="O365BusinessRetail">
      <Language ID="vi-vn" />
      <Language ID="en-us" />
      <ExcludeApp ID="Groove" />
      <ExcludeApp ID="Lync" />
      <ExcludeApp ID="OneDrive" />
      <ExcludeApp ID="Teams" />
      <ExcludeApp ID="Bing" />
    </Product>
  </Add>
  <Property Name="AUTOACTIVATE" Value="0" />
  <Property Name="FORCEAPPSHUTDOWN" Value="TRUE" />
  <Property Name="SharedComputerLicensing" Value="0" />
  <Updates Enabled="TRUE" />
  <RemoveMSI />
  <Display Level="None" AcceptEULA="TRUE" />
</Configuration>
